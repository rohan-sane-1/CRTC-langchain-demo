# Copy to backend/.env and fill in. Never commit the real .env.

# --- LangSmith (used from Phase 5; harmless to set now) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=crtc-copilot-dev

# --- LLM / embeddings (used from Phase 3-4) ---
GOOGLE_API_KEY=
# Copy the exact model ID from Google AI Studio; names change.
LLM_MODEL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the embedding model's output size. Fixed into the DB schema by the migration.
EMBEDDING_DIM=384

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://crtc:crtc@localhost:5433/crtc

# --- Auth ---
# Same Web OAuth client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
# Long random string (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Comma-separated emails allowed to log in. Empty = any Google account can log in.
ALLOWED_EMAILS=
# Exact origin of the frontend (used for CORS and the CSRF Origin check). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000
